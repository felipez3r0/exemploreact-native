# Configuração do Firebase
# ────────────────────────────────────────────────────────────────────
# Este arquivo serve como MODELO para o arquivo .env real.
# 
# IMPORTANTE: NÃO coloque valores reais neste arquivo!
# Este arquivo deve ser commitado no Git para documentar quais
# variáveis de ambiente são necessárias para o projeto funcionar.
#
# Como usar:
# 1. Copie este arquivo: cp .env.example .env
# 2. Abra o .env e preencha com os valores REAIS do Firebase Console
# 3. O arquivo .env está no .gitignore — nunca será commitado
#
# Obtenha estes valores em: https://console.firebase.google.com
# Navegue até: Configurações do projeto > Seus aplicativos > Configuração do SDK

# Firebase Config (obrigatórios)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client ID (Web) — para Expo Go
# Obtenha em: Google Cloud Console > APIs e Serviços > Credenciais
# Tipo: "ID do cliente OAuth 2.0" para "Aplicativo da Web"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth Client IDs (iOS/Android) — para builds de produção (EAS Build)
# Obtenha em: Google Cloud Console > APIs e Serviços > Credenciais
# iOS: Tipo "ID do cliente OAuth 2.0" para "iOS"
# Android: Tipo "ID do cliente OAuth 2.0" para "Android"
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
